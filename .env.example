# LLM provider. Set ONE key; TrustLoop picks the provider from it (Gemini wins if both are set).
# With no key, TrustLoop runs its offline engine (rule-based extraction, simulated agent).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional overrides
TRUSTLOOP_LLM=                  # claude | gemini | offline
TRUSTLOOP_MODEL=                # empty = Claude: claude-opus-5-5; Gemini: newest stable Flash model your key can use
TRUSTLOOP_FALLBACKS=1           # Claude only: server-side refusal fallbacks

# Protects /api, /mcp and /sse. Send it as "Authorization: Bearer <key>", "X-API-Key: <key>" or ?key=<key>.
# Leave empty if Talkdesk's MCP registration can't send a header.
TRUSTLOOP_API_KEY=

# Talkdesk Automation Flow webhook that sends customer messages (SMS/email). Empty = messages are queued.
TRUSTLOOP_WEBHOOK_URL=

# 1 = record_promise warns CardCare at once when a promise breaks policy (a live guardrail).
TRUSTLOOP_LIVE_GUARD=0

TRUSTLOOP_DB=trustloop.db
